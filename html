<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Between Us</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&display=swap');
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; background: #140d26; }
  #root { min-height: 100vh; }
  @keyframes bu-rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes bu-twinkle { 0%,100% { opacity: var(--o); } 50% { opacity: calc(var(--o) * 0.35); } }
  @media (prefers-reduced-motion: reduce) {
    .bu-rise, .bu-star, .bu-flip { animation: none !important; transition: none !important; }
  }
</style>
<script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
<script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
<script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
</head>
<body>
<div id="root"></div>

<script type="text/babel">
const { useMemo, useState, useCallback, useRef } = React;

const THREADS = {
  back:    { label: "Looking back",    color: "#e79a8f" },
  future:  { label: "Dreams & future", color: "#f2c66d" },
  us:      { label: "Us",              color: "#ef9bb3" },
  believe: { label: "What you believe",color: "#9db4f0" },
  fun:     { label: "Just for fun",    color: "#86d6c0" },
  heart:   { label: "Heart",           color: "#ef8f8f" },
};

const BANK = {
  back: [
    "What's a small moment from your childhood that shaped you more than people realise?",
    "Who did you want to be when you grew up, and how do you feel about that now?",
    "What's a memory you'd happily relive exactly as it was?",
    "When did you first feel like an adult?",
    "What did you believe as a kid that you wish were still true?",
    "What's something your younger self would be proud of you for?",
    "What's the bravest thing you did before we met?",
    "Which teacher, coach, or stranger changed your life without knowing it?",
    "What's a smell or song that instantly takes you back somewhere?",
    "What was your family like around the dinner table growing up?",
    "What's a risk you took that you're glad you took?",
    "What did home feel like when you were young?",
  ],
  future: [
    "If money and time weren't a factor, how would you spend a normal Tuesday?",
    "What's something you want to be able to say you did by the time you're old?",
    "Where do you picture us in five years, honestly?",
    "What's a skill you secretly want to master?",
    "If we could live anywhere for a year, where would you pick and why?",
    "What kind of older person do you hope to become?",
    "What's a dream you've never said out loud?",
    "What would you do if you knew you couldn't fail?",
    "What does a good life actually look like to you?",
    "Is there something you want to create or build one day?",
    "What tradition would you want us to start together?",
    "What's worth being patient for?",
  ],
  us: [
    "When did you first know you actually liked me?",
    "What's something I do that makes you feel loved without me trying?",
    "What do you think we're really good at as a team?",
    "What's a moment with me you keep coming back to?",
    "How do you most like to be comforted when things are hard?",
    "What's something you'd like more of from us?",
    "What made you feel safe with me early on?",
    "What's a tiny thing I do that you'd miss if it were gone?",
    "What do you hope people notice about us?",
    "When do you feel closest to me?",
    "What's something we've gotten through that made us stronger?",
    "What would you want me to remember on a day you're struggling?",
  ],
  believe: [
    "What's a belief you've completely changed your mind about?",
    "What does being a good person mean to you?",
    "Is there something most people accept that you quietly disagree with?",
    "What do you think you're here to do?",
    "When is it right to break a rule?",
    "What matters more to you: being right or being kind?",
    "What's something you'd never compromise on?",
    "Do you think people can really change? Why?",
    "What's the most important thing money can't buy?",
    "What do you owe to the people you love?",
    "What's a value you got from your family that you want to keep?",
    "What does forgiveness mean to you?",
  ],
  fun: [
    "If we swapped lives for a day, what would surprise you most?",
    "You get one superpower, but it's mildly inconvenient. What is it?",
    "What fictional world would you actually want to live in?",
    "If our life together were a film, what genre is it?",
    "What's the most useless talent you're weirdly proud of?",
    "If you had to eat one cuisine forever, which wins?",
    "What would your villain origin story be?",
    "If you could instantly know one true thing, what would you ask?",
    "What animal do you reckon I'd be, and why?",
    "We win the lottery tomorrow. What's the first ridiculous thing we buy?",
    "What's a hill you'll die on that doesn't actually matter?",
    "If you could time travel once, past or future?",
  ],
  heart: [
    "What's something you're afraid of that you don't talk about much?",
    "When do you feel most like yourself?",
    "What's been the hardest year of your life, and what got you through it?",
    "What do you need more of right now?",
    "What's something you're proud of but never brag about?",
    "When did you last feel truly seen?",
    "What makes you feel small, and what makes you feel strong?",
    "What's a weight you're still carrying that you'd like to put down?",
    "What do you wish people understood about you?",
    "What's something you've forgiven yourself for, or want to?",
    "When did you last cry, and was it a good cry or a hard one?",
    "What are you grateful for today that's easy to overlook?",
  ],
};

const ORDERED = (() => {
  const keys = Object.keys(BANK);
  const out = [];
  const max = Math.max(...keys.map((k) => BANK[k].length));
  let id = 0;
  for (let i = 0; i < max; i++) {
    for (const k of keys) {
      if (BANK[k][i]) out.push({ id: id++, thread: k, q: BANK[k][i] });
    }
  }
  return out;
})();

function fiveForToday(now) {
  const dayNum = Math.floor(
    Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) / 86400000
  );
  const start = (dayNum * 5) % ORDERED.length;
  const five = [];
  for (let i = 0; i < 5; i++) five.push(ORDERED[(start + i) % ORDERED.length]);
  return five;
}

const Chevron = ({ dir = "right", size = 22 }) => (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none"
    style={{ transform: dir === "left" ? "scaleX(-1)" : "none" }} aria-hidden="true">
    <path d="M9 5l7 7-7 7" stroke="currentColor" strokeWidth="1.8"
      strokeLinecap="round" strokeLinejoin="round" />
  </svg>
);
const Heart = ({ filled, size = 20 }) => (
  <svg width={size} height={size} viewBox="0 0 24 24"
    fill={filled ? "currentColor" : "none"} aria-hidden="true">
    <path d="M12 20s-7-4.35-9.5-8.5C.9 8.6 2.2 5.5 5.2 5.5c1.8 0 3 1 2.8 1 .8-.9 1.9-1.5 3-1.5 3 0 4.3 3.1 2.7 6C19 15.65 12 20 12 20z"
      stroke="currentColor" strokeWidth="1.6" strokeLinejoin="round" />
  </svg>
);
const Copy = ({ size = 18 }) => (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <rect x="9" y="9" width="11" height="11" rx="2.4" stroke="currentColor" strokeWidth="1.6" />
    <path d="M5 15V5.5A1.5 1.5 0 016.5 4H15" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round" />
  </svg>
);
const Moon = ({ size = 30 }) => (
  <svg width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <path d="M23 20.5A9.5 9.5 0 0111.8 6.2 9.5 9.5 0 1023 20.5z" fill="#f2c66d" fillOpacity="0.9" />
  </svg>
);

function BetweenUs() {
  const now = useMemo(() => new Date(), []);
  const cards = useMemo(() => fiveForToday(now), [now]);

  const [index, setIndex] = useState(0);
  const [revealed, setRevealed] = useState([false, false, false, false, false]);
  const [faves, setFaves] = useState(() => new Set());
  const [copied, setCopied] = useState(false);
  const rootRef = useRef(null);

  const dateStr = now.toLocaleDateString("en-AU", { weekday: "long", day: "numeric", month: "long" });

  const reveal = useCallback((i) => {
    setRevealed((r) => (r[i] ? r : r.map((v, k) => (k === i ? true : v))));
  }, []);
  const go = useCallback((dir) => {
    setCopied(false);
    setIndex((i) => Math.min(4, Math.max(0, i + dir)));
  }, []);
  const toggleFave = useCallback((id) => {
    setFaves((f) => { const n = new Set(f); n.has(id) ? n.delete(id) : n.add(id); return n; });
  }, []);
  const copyCurrent = useCallback(async (text) => {
    try { await navigator.clipboard.writeText(text); } catch (e) {}
    setCopied(true); setTimeout(() => setCopied(false), 1600);
  }, []);
  const onKey = useCallback((e) => {
    if (e.key === "ArrowRight") { e.preventDefault(); go(1); }
    else if (e.key === "ArrowLeft") { e.preventDefault(); go(-1); }
    else if (e.key === " " || e.key === "Enter") { e.preventDefault(); reveal(index); }
  }, [go, reveal, index]);

  const stars = useMemo(() => {
    const s = []; let seed = 7;
    const rnd = () => { seed = (seed * 1103515245 + 12345) & 0x7fffffff; return seed / 0x7fffffff; };
    for (let i = 0; i < 34; i++) s.push({ x: rnd()*100, y: rnd()*62, r: 0.6+rnd()*1.4, o: 0.25+rnd()*0.55, d: rnd()*4 });
    return s;
  }, []);

  const card = cards[index];
  const thread = THREADS[card.thread];
  const isRevealed = revealed[index];
  const allDone = revealed.every(Boolean);

  return (
    <div ref={rootRef} tabIndex={0} onKeyDown={onKey}
      style={{ position:"relative", minHeight:"100vh", width:"100%", outline:"none", color:"#f4eee4",
        fontFamily:"system-ui, -apple-system, 'Segoe UI', sans-serif",
        background:"radial-gradient(120% 80% at 50% 108%, rgba(242,198,109,0.22), rgba(242,198,109,0) 60%),linear-gradient(180deg, #140d26 0%, #1e1436 42%, #2c1c4a 78%, #3a2456 100%)",
        overflow:"hidden", display:"flex", flexDirection:"column", alignItems:"center" }}>

      <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"
        style={{ position:"absolute", inset:0, width:"100%", height:"100%", pointerEvents:"none" }}>
        {stars.map((s, i) => (
          <circle key={i} className="bu-star" cx={s.x} cy={s.y} r={s.r} fill="#fdf6e6"
            style={{ "--o": s.o, opacity: s.o, animation: `bu-twinkle ${3+s.d}s ease-in-out ${s.d}s infinite` }} />
        ))}
      </svg>

      <div style={{ position:"relative", width:"min(560px, 92vw)", padding:"clamp(28px,6vh,56px) 0 40px", display:"flex", flexDirection:"column", alignItems:"center", flex:1 }}>
        <header className="bu-rise" style={{ textAlign:"center", animation:"bu-rise .7s ease both", marginBottom:"clamp(20px,4vh,36px)" }}>
          <div style={{ display:"flex", justifyContent:"center", marginBottom:10, filter:"drop-shadow(0 0 14px rgba(242,198,109,0.5))" }}><Moon /></div>
          <h1 style={{ fontFamily:"'Fraunces', Georgia, serif", fontWeight:500, fontSize:"clamp(2rem,7vw,2.7rem)", margin:0, letterSpacing:"-0.01em" }}>Between Us</h1>
          <p style={{ margin:"8px 0 0", color:"#c3b6db", fontSize:"0.95rem" }}>Five questions for {dateStr}</p>
        </header>

        <div className="bu-rise" style={{ animation:"bu-rise .7s ease .1s both", width:"100%", perspective:"1400px", flex:"0 0 auto" }}>
          <div className="bu-flip" onClick={() => reveal(index)} role="button"
            aria-label={isRevealed ? "Question" : "Tap to reveal the question"}
            style={{ position:"relative", width:"100%", minHeight:"min(56vh, 380px)",
              cursor:isRevealed ? "default" : "pointer", transformStyle:"preserve-3d",
              transition:"transform .6s cubic-bezier(.2,.7,.2,1)", transform:isRevealed ? "rotateY(180deg)" : "none" }}>

            <Face front thread={thread}>
              <div style={{ display:"flex", flexDirection:"column", alignItems:"center", gap:16, textAlign:"center", padding:"0 24px" }}>
                <ThreadPill thread={thread} />
                <div style={{ fontFamily:"'Fraunces', serif", fontSize:"clamp(3rem,12vw,4.5rem)", lineHeight:1, color:thread.color, opacity:0.9 }}>{index + 1}</div>
                <p style={{ margin:0, color:"#cabfe4", fontSize:"0.98rem" }}>Tap to reveal</p>
              </div>
            </Face>

            <Face thread={thread}>
              <div style={{ display:"flex", flexDirection:"column", height:"100%", padding:"26px 24px 20px" }}>
                <ThreadPill thread={thread} />
                <div style={{ flex:1, display:"flex", alignItems:"center", justifyContent:"center" }}>
                  <p style={{ fontFamily:"'Fraunces', Georgia, serif", fontWeight:400, fontSize:"clamp(1.5rem,5.2vw,2.1rem)", lineHeight:1.28, textAlign:"center", margin:0, letterSpacing:"-0.01em" }}>{card.q}</p>
                </div>
                <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center" }}>
                  <IconBtn label={faves.has(card.id) ? "Remove favourite" : "Save favourite"} active={faves.has(card.id)} activeColor="#ef8f8f"
                    onClick={(e) => { e.stopPropagation(); toggleFave(card.id); }}><Heart filled={faves.has(card.id)} /></IconBtn>
                  <span style={{ color:"#a99cc6", fontSize:"0.82rem" }}>Take turns answering</span>
                  <IconBtn label="Copy question" onClick={(e) => { e.stopPropagation(); copyCurrent(card.q); }}><Copy /></IconBtn>
                </div>
              </div>
            </Face>
          </div>
        </div>

        <div style={{ display:"flex", gap:10, margin:"22px 0 18px", alignItems:"center" }}>
          {cards.map((c, i) => (
            <button key={c.id} aria-label={`Go to question ${i + 1}`} onClick={() => { setIndex(i); setCopied(false); }}
              style={{ width:i===index?26:9, height:9, borderRadius:9, border:"none", cursor:"pointer", padding:0,
                background:i===index?THREADS[c.thread].color:revealed[i]?"rgba(255,255,255,0.5)":"rgba(255,255,255,0.2)", transition:"all .3s ease" }} />
          ))}
        </div>

        <div style={{ display:"flex", alignItems:"center", justifyContent:"center", gap:14, width:"100%" }}>
          <NavBtn disabled={index===0} onClick={() => go(-1)} label="Previous"><Chevron dir="left" /></NavBtn>
          <span style={{ minWidth:64, textAlign:"center", color:"#c3b6db", fontSize:"0.9rem", fontVariantNumeric:"tabular-nums" }}>{index + 1} of 5</span>
          <NavBtn disabled={index===4} onClick={() => go(1)} label="Next"><Chevron dir="right" /></NavBtn>
        </div>

        <div aria-live="polite" style={{ height:22, marginTop:12 }}>
          {copied && <span style={{ color:"#f2c66d", fontSize:"0.85rem" }}>Copied — go send it 💛</span>}
        </div>

        <p style={{ marginTop:"auto", paddingTop:24, color:"#8f83ad", fontSize:"0.8rem", textAlign:"center" }}>
          {allDone ? "That's tonight's five. New questions tomorrow." : "New questions every day."}
        </p>
      </div>
    </div>
  );
}

function Face({ children, front, thread }) {
  return (
    <div style={{ position:"absolute", inset:0, backfaceVisibility:"hidden", WebkitBackfaceVisibility:"hidden",
      transform:front ? "none" : "rotateY(180deg)", borderRadius:22, display:"flex", alignItems:"center", justifyContent:"center",
      background:"linear-gradient(165deg, rgba(255,255,255,0.09), rgba(255,255,255,0.03))",
      border:`1px solid ${thread.color}44`,
      boxShadow:`0 24px 60px -24px rgba(0,0,0,0.65), inset 0 1px 0 rgba(255,255,255,0.08), 0 0 42px -18px ${thread.color}66`,
      backdropFilter:"blur(10px)", WebkitBackdropFilter:"blur(10px)" }}>
      {children}
    </div>
  );
}
function ThreadPill({ thread }) {
  return (
    <span style={{ alignSelf:"center", display:"inline-flex", alignItems:"center", gap:7, padding:"5px 13px", borderRadius:999,
      background:`${thread.color}1f`, border:`1px solid ${thread.color}55`, color:thread.color, fontSize:"0.8rem", fontWeight:500, letterSpacing:"0.01em" }}>
      <span style={{ width:6, height:6, borderRadius:6, background:thread.color }} />{thread.label}
    </span>
  );
}
function IconBtn({ children, onClick, label, active, activeColor }) {
  return (
    <button onClick={onClick} aria-label={label} aria-pressed={active}
      style={{ display:"grid", placeItems:"center", width:40, height:40, borderRadius:12, cursor:"pointer",
        background:"rgba(255,255,255,0.06)", border:"1px solid rgba(255,255,255,0.12)", color:active?activeColor:"#e5ddf1", transition:"all .2s ease" }}>
      {children}
    </button>
  );
}
function NavBtn({ children, onClick, disabled, label }) {
  return (
    <button onClick={onClick} disabled={disabled} aria-label={label}
      style={{ display:"grid", placeItems:"center", width:52, height:52, borderRadius:999, cursor:disabled?"default":"pointer",
        background:disabled?"rgba(255,255,255,0.03)":"rgba(255,255,255,0.09)", border:"1px solid rgba(255,255,255,0.14)",
        color:disabled?"#5b5175":"#f4eee4", opacity:disabled?0.5:1, transition:"all .2s ease" }}>
      {children}
    </button>
  );
}

ReactDOM.createRoot(document.getElementById("root")).render(<BetweenUs />);
</script>
</body>
</html>
